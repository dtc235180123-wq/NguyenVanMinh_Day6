@model IEnumerable<NguyenVanMinh_Day6.Models.Movie>

@{
    ViewData["Title"] = "Danh sách Phim";
}

<div class="card card-modern p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0"><i class="bi bi-camera-reels-fill text-primary me-2"></i>Danh sách Phim</h3>
            <p class="text-muted small mb-0">Quản lý thông tin phim, ngày phát hành và thể loại</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-pill shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Thêm mới
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Title)</th>
                    <th>@Html.DisplayNameFor(model => model.ReleaseDate)</th>
                    <th>@Html.DisplayNameFor(model => model.Duration)</th>
                    <th>@Html.DisplayNameFor(model => model.Genre)</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold text-dark">@Html.DisplayFor(modelItem => item.Title)</td>
                        <td>
                            <i class="bi bi-calendar3 text-muted me-1"></i>
                            @item.ReleaseDate.ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-clock me-1"></i>@item.Duration phút
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-info text-dark px-3 py-2 rounded-pill">
                                @Html.DisplayFor(modelItem => item.Genre.Name)
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-dark fw-semibold me-1">
                                <i class="bi bi-pencil-square"></i> Sửa
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white fw-semibold me-1">
                                <i class="bi bi-eye"></i> Chi tiết
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger fw-semibold">
                                <i class="bi bi-trash"></i> Xóa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>