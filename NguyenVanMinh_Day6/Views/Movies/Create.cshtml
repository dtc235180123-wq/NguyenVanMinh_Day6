@model NguyenVanMinh_Day6.Models.Movie

@{
    ViewData["Title"] = "Thêm phim mới";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card card-modern p-4">
            <div class="border-bottom pb-3 mb-4">
                <h4 class="fw-bold text-primary mb-1"><i class="bi bi-plus-square-fill me-2"></i>Thêm phim mới</h4>
                <p class="text-muted small mb-0">Điền đầy đủ thông tin bộ phim vào biểu mẫu bên dưới</p>
            </div>

            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold"></label>
                    <input asp-for="Title" class="form-control form-control-lg" placeholder="Nhập tên phim..." />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ReleaseDate" class="form-label fw-semibold"></label>
                        <input asp-for="ReleaseDate" class="form-control" />
                        <span asp-validation-for="ReleaseDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Duration" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="Duration" class="form-control" placeholder="120" />
                            <span class="input-group-text">phút</span>
                        </div>
                        <span asp-validation-for="Duration" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="GenreId" class="form-label fw-semibold"></label>
                    <select asp-for="GenreId" class="form-select" asp-items="ViewBag.GenreId">
                        <option value="">-- Chọn thể loại phim --</option>
                    </select>
                </div>

                <div class="d-flex justify-content-between pt-2">
                    <a asp-action="Index" class="btn btn-light border px-4">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-check-circle me-1"></i> Lưu phim
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}